{
  "name": "patrick-maynard/mock-it-all",
  "type": "library",
  "bin": ["bin/mock-it-all"],
  "description": "A simple tool that allows developers to automatically generate mock logic for PHPUnit tests",
  "keywords": ["testing", "mocking", "debugging"],
  "homepage": "http://home.patrickmaynard.com",
  "license": "MIT",
  "minimum-stability": "dev",
  "authors": [
    {
      "name": "Patrick Maynard",
      "email": "patrick.maynard@markenfilm-space.de",
      "homepage": "http://home.patrickmaynard.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.0",
    "twig/twig": "*",
    "symfony/console": "8.2.x-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4" : {
      "PatrickMaynard\\MockItAll\\": "src/"
    },
  },
  "autoload-dev": {
    "psr-4" : {
      "PatrickMaynard\\MockItAll\\Tests\\" : "tests/"
    }
  }
}

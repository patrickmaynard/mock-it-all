#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace composer;

use PatrickMaynard\MockItAll\MockLogicCreator;
use PatrickMaynard\MockItAll\Stubs\President;
use PatrickMaynard\MockItAll\CommandHelpers\ClassSelector;
use PatrickMaynard\MockItAll\CommandHelpers\TestFolderSelector;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Output\OutputInterface;


//We assign the loader to a variable while autoloading rather than doing the autoloading alone. 
//This allows us to later call $loader->getClassMap() to allow autocompletion of FQCNs. 
$loader = include $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

$application = new Application();





        //Populate the list of classes that can be autocompleted.
        //Unless we explicitly get an --include-vendor-classes flag, we should skip those.
        //
        //getClassMap() only returns classes registered via Composer's classmap
        //autoloading. Project classes autoloaded via PSR-4 (like our own src/
        //classes) are resolved lazily and never appear there unless the
        //autoloader was dumped with --optimize/--classmap-authoritative. So we
        //also walk the loader's registered PSR-4 prefixes ourselves to pick up
        //project classes regardless of how the autoloader was dumped.
        $vendorDir = realpath(__DIR__ . '/../vendor') ?: false;

        $classMap = $loader->getClassMap();
        foreach ($loader->getPrefixesPsr4() as $namespacePrefix => $directories) {
            foreach ($directories as $directory) {
                $directory = rtrim($directory, '/');
                if (!is_dir($directory)) {
                    continue;
                }
                $files = new \RegexIterator(
                    new \RecursiveIteratorIterator(
                        new \RecursiveDirectoryIterator($directory, \FilesystemIterator::SKIP_DOTS)
                    ),
                    '/\.php$/'
                );
                foreach ($files as $file) {
                    $relativePath = substr($file->getPathname(), strlen($directory) + 1);
                    $relativeClass = substr($relativePath, 0, -4); // strip ".php"
                    $className = $namespacePrefix . str_replace('/', '\\', $relativeClass);
                    $classMap[$className] = $file->getPathname();
                }
            }
        }


// ... register a command that creates a test stub with mocking
$application->register('create-test-stub-with-mocks')
    ->addOption('show-class-list-and-exit', null, InputOption::VALUE_NONE, 'Just show the class list?')
    ->addOption('include-vendor-classes', null, InputOption::VALUE_NONE, 'Include vendor classes?')
    ->addOption('dump-output-without-write', null, InputOption::VALUE_NONE, 'Dump logic direct to stdout?')
    ->addOption('fqcn', null, InputOption::VALUE_REQUIRED, 'The fully-qualified class name to generate a test stub for. Omit to pick one interactively.')
    ->addOption('test-folder', null, InputOption::VALUE_REQUIRED, 'The folder (relative to the project root) that should hold the generated test stub. Omit to pick one interactively.')
    ->setCode(function (InputInterface $input, OutputInterface $output) use ($classMap, $vendorDir): int {

        //Set up our list of autocomplete classes 
        $classesForAutoComplete = [];
        foreach ($classMap as $className => $path) {
            $realPath = realpath($path) ?: $path;
            $isVendorClass = $vendorDir !== false && str_starts_with($realPath, $vendorDir . DIRECTORY_SEPARATOR);
            if (!$isVendorClass || $input->getOption('include-vendor-classes')) {
                $classesForAutoComplete[] = $className;
            }
        }

        //If we're just showing available classes and exiting, then do that.
        if ($input->getOption('show-class-list-and-exit')) {
            print PHP_EOL . 
                (
                    $input->getOption('include-vendor-classes') ? 
                    'Vendor classes are being included. ' : 
                    'Vendor classes are being omitted. ') .
                'Here is a list of available classes: ' . 
                PHP_EOL . 
                PHP_EOL . 
                implode(PHP_EOL, $classesForAutoComplete) . 
                PHP_EOL . 
                PHP_EOL 
                ;  
            return Command::SUCCESS;
        }        

        //Here is where we do the actual creation of the output.
        $stubLogic = PHP_EOL . PHP_EOL;
        $mockLogicCreator = new MockLogicCreator;
        //$stubLogic = $mockLogicCreator->createTestClassStub(President::class);

        //Whichever of --fqcn / --test-folder wasn't given explicitly is
        //collected via its own interactive selector below. Give both and the
        //command is fully non-interactive; omit both and it's the full wizard.
        $fqcnOption = $input->getOption('fqcn');
        $testFolderOption = $input->getOption('test-folder');

        $needsClassSelector = ($fqcnOption === null || $fqcnOption === '');
        $needsTestFolderSelector = ($testFolderOption === null || $testFolderOption === '');

        //Both the wizard and the direct (fqcn + --test-folder) path need to know
        //where to write the generated stub, which means we need to be run
        //from the root of a project (the folder containing composer.json).
        $projectRoot = getcwd();

        if ($projectRoot === false || !is_file($projectRoot . '/composer.json')) {
            print PHP_EOL .
                PHP_EOL .
                'This command must be run from the root of your project ' .
                '(the folder containing composer.json). Exiting. ' .
                PHP_EOL .
                PHP_EOL
                ;
            return Command::FAILURE;
        }

        if ($needsClassSelector) {
            $selector = new ClassSelector($classesForAutoComplete);
            $class = $selector->ask($input, $output);

            if ($class === null || $class === '') {
                print PHP_EOL .
                    PHP_EOL .
                    'You did not choose a class. Exiting. ' .
                    PHP_EOL .
                    PHP_EOL
                    ;
                return Command::FAILURE;
            }

            $output->writeln('');
            $output->writeln(sprintf(
                'Generating stub for <info>%s</info>.',
                $class,
            ));
            $fqcn = $class;
        } else {
            $fqcn = $fqcnOption;
        }

        if ($needsTestFolderSelector) {
            $testFolderSelector = TestFolderSelector::forProjectRoot($projectRoot);

            if ($testFolderSelector === null && !$input->getOption('dump-output-without-write')) {
                print PHP_EOL .
                    PHP_EOL .
                    'No "tests" or "test" folder was found, and --dump-output-without-write flag was not used. ' .
                    'Please create one before using this command. ' .
                    PHP_EOL .
                    PHP_EOL
                    ;
                return Command::FAILURE;
            }

            $testFolder = $testFolderSelector?->ask($input, $output);

            if (($testFolder === null || $testFolder === '') && !$input->getOption('dump-output-without-write')) {
                print PHP_EOL .
                    PHP_EOL .
                    'You did not choose a test folder, and the --dump-output-without-write flag was not used. ' .
                    'Exiting. ' .
                    PHP_EOL .
                    PHP_EOL
                    ;
                return Command::FAILURE;
            }

            $output->writeln('');
            $output->writeln(sprintf(
                'Using test folder <info>%s</info>.',
                $testFolder,
            ));

            $testFolderPath = rtrim($projectRoot, '/\\') . DIRECTORY_SEPARATOR
                . str_replace('/', DIRECTORY_SEPARATOR, $testFolder ?? '');
        } else {
            $testFolder = $testFolderOption;

            $testFolderPath = rtrim($projectRoot, '/\\') . DIRECTORY_SEPARATOR
                . str_replace('/', DIRECTORY_SEPARATOR, $testFolder);

            if (!is_dir($testFolderPath)) {
                print PHP_EOL .
                    PHP_EOL .
                    'The --test-folder "' . $testFolder . '" does not exist. ' .
                    'Please create it first, or choose an existing folder. ' .
                    PHP_EOL .
                    PHP_EOL
                    ;
                return Command::FAILURE;
            }
        }

        try {
            $stubLogic  = $mockLogicCreator->createTestClassStub($fqcn);
        } catch (\TypeError $e) {
            $stubLogic  = 'The class was not found or was improperly entered.' . PHP_EOL;
            $stubLogic .= 'Use the command with this type of formatting:  ' . PHP_EOL;
            $stubLogic .= PHP_EOL;
            $stubLogic .= 'php ./vendor/bin/mock-it-all/execute create-test-stub-with-mocks ';
            $stubLogic .= '--fqcn="PatrickMaynard\MockItAll\Stubs\President" --test-folder=tests';

            print PHP_EOL . $stubLogic . PHP_EOL . PHP_EOL;

            return Command::FAILURE;
        } catch (\Throwable $e) {
            print PHP_EOL . 'An unexpected error occured.' . PHP_EOL . PHP_EOL;

            return Command::FAILURE;
        }


        if ($input->getOption('dump-output-without-write')) {
            //We're just dumping the test logic directly to stdout, per the user's wishes.
            print PHP_EOL . 
                PHP_EOL . 
                $stubLogic .
                PHP_EOL . 
                PHP_EOL 
               ; 
        } else {
            //Write the stub out to a file in the chosen test folder, named after
            //the class being tested (e.g. President -> PresidentTest.php).
            $shortClassName = $fqcn;
            $lastBackslashPosition = strrpos($fqcn, '\\');
            if ($lastBackslashPosition !== false) {
                $shortClassName = substr($fqcn, $lastBackslashPosition + 1);
            }

            $testStubPath = rtrim($testFolderPath, '/\\') . DIRECTORY_SEPARATOR . $shortClassName . 'Test.php';

            if (file_exists($testStubPath)) {
                print PHP_EOL .
                    PHP_EOL .
                    'A file already exists at "' . $testStubPath . '". Not overwriting it. Exiting. ' .
                    PHP_EOL .
                    PHP_EOL
                    ;
                return Command::FAILURE;
            }

            //The wizard's folder autocomplete allows freely-typed paths that
            //don't exist yet (e.g. a new descendant directory), so create the
            //folder here if needed. (The --no-wizard --test-folder path was
            //already required to exist above.)
            if (!is_dir($testFolderPath) && !mkdir($testFolderPath, 0777, true) && !is_dir($testFolderPath)) {
                print PHP_EOL .
                    PHP_EOL .
                    'Could not create the test folder "' . $testFolderPath . '". Exiting. ' .
                    PHP_EOL .
                    PHP_EOL
                    ;
                return Command::FAILURE;
            }
            file_put_contents($testStubPath, $stubLogic);

            $output->writeln('');
            $output->writeln(sprintf(
                'Test stub written to <info>%s</info>.',
                $testStubPath,
            ));
        }

        print PHP_EOL . 'Test stub code:' . PHP_EOL . '=====' . PHP_EOL . $stubLogic . PHP_EOL . '====' . PHP_EOL;

        return Command::SUCCESS;
    });

$application->run();
